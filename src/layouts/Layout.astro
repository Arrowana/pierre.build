---
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const siteTitle = 'pierre.build';
const description =
  Astro.props.description ??
  'Minimal notes and protocol work from Pierre, focused on Solana, signing UX, and low-level tooling.';
const pageTitle = Astro.props.title ? `${Astro.props.title} - ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">pierre.build</a>
        <nav class="nav" aria-label="Primary">
          <a href="/">home</a>
          <a href="/blog">blog</a>
          <a href="https://github.com/Arrowana">github</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a class="github-footer-link" href="https://github.com/Arrowana" aria-label="GitHub profile">
          <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          <span>$ open github.com/Arrowana</span>
        </a>
      </footer>
    </div>
  </body>
</html>
